="470" height="46" presetHandlers="8"><fill><fillColor color="rgb(244,247,250)"/></fill></shape><shape type="round-rect" topLeftX="70" topLeftY="142" width="4" height="46" presetHandlers="2"><fill><fillColor color="rgb(74,127,165)"/></fill></shape><shape type="text" topLeftX="88" topLeftY="149" width="80" height="16"><content textType="body" fontSize="10" color="rgb(74,127,165)" textAlign="left" fontFamily="Roboto Mono" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0" bold="true"><p>输入</p></content></shape><shape type="text" topLeftX="88" topLeftY="166" width="440" height="18"><content textType="body" fontSize="11.5" color="rgb(43,47,54)" textAlign="left" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0"><p>Stage 1 候选：证据链 + 行号 + 代码切片</p></content></shape><line startX="305" startY="188" endX="305" endY="200"><border color="rgb(160,172,182)" width="2"/><endArrow type="arrow"/></line><shape type="round-rect" topLeftX="70" topLeftY="200" width="470" height="46" presetHandlers="8"><fill><fillColor color="rgb(244,247,250)"/></fill></shape><shape type="round-rect" topLeftX="70" topLeftY="200" width="4" height="46" presetHandlers="2"><fill><fillColor color="rgb(111,163,155)"/></fill></shape><shape type="text" topLeftX="88" topLeftY="207" width="80" height="16"><content textType="body" fontSize="10" color="rgb(111,163,155)" textAlign="left" fontFamily="Roboto Mono" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0" bold="true"><p>处理 1</p></content></shape><shape type="text" topLeftX="88" topLeftY="224" width="440" height="18"><content textType="body" fontSize="11.5" color="rgb(43,47,54)" textAlign="left" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0"><p>RAG 检索注入对应 CWE 的判据与安全反例</p></content></shape><line startX="305" startY="246" endX="305" endY="258"><border color="rgb(160,172,182)" width="2"/><endArrow type="arrow"/></line><shape type="round-rect" topLeftX="70" topLeftY="258" width="470" height="46" presetHandlers="8"><fill><fillColor color="rgb(244,247,250)"/></fill></shape><shape type="round-rect" topLeftX="70" topLeftY="258" width="4" height="46" presetHandlers="2"><fill><fillColor color="rgb(111,163,155)"/></fill></shape><shape type="text" topLeftX="88" topLeftY="265" width="80" height="16"><content textType="body" fontSize="10" color="rgb(111,163,155)" textAlign="left" fontFamily="Roboto Mono" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0" bold="true"><p>处理 2</p></content></shape><shape type="text" topLeftX="88" topLeftY="282" width="440" height="18"><content textType="body" fontSize="11.5" color="rgb(43,47,54)" textAlign="left" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0"><p>CodeSlicer 切出最小相关上下文，拒绝整文件投喂</p></content></shape><line startX="305" startY="304" endX="305" endY="316"><border color="rgb(160,172,182)" width="2"/><endArrow type="arrow"/></line><shape type="round-rect" topLeftX="70" topLeftY="316" width="470" height="46" presetHandlers="8"><fill><fillColor color="rgb(244,247,250)"/></fill></shape><shape type="round-rect" topLeftX="70" topLeftY="316" width="4" height="46" presetHandlers="2"><fill><fillColor color="rgb(111,163,155)"/></fill></shape><shape type="text" topLeftX="88" topLeftY="323" width="80" height="16"><content textType="body" fontSize="10" color="rgb(111,163,155)" textAlign="left" fontFamily="Roboto Mono" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0" bold="true"><p>处理 3</p></content></shape><shape type="text" topLeftX="88" topLeftY="340" width="440" height="18"><content textType="body" fontSize="11.5" color="rgb(43,47,54)" textAlign="left" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0"><p>N=3 次独立采样，多数投票定结论</p></content></shape><shape type="round-rect" topLeftX="70" topLeftY="374" width="146" height="46" presetHandlers="8"><fill><fillColor color="rgb(247,235,234)"/></fill></shape><shape type="text" topLeftX="70" topLeftY="382" width="146" height="18"><content textType="body" fontSize="12" color="rgb(192,80,77)" textAlign="center" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0" bold="true"><p>确认漏洞</p></content></shape><shape type="text" topLeftX="70" topLeftY="402" width="146" height="16"><content textType="body" fontSize="9" color="rgb(91,103,112)" textAlign="center" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0"><p>带 CWE 编号与理由</p></content></shape><shape type="round-rect" topLeftX="232" topLeftY="374" width="146" height="46" presetHandlers="8"><fill><fillColor color="rgb(233,242,240)"/></fill></shape><shape type="text" topLeftX="232" topLeftY="382" width="146" height="18"><content textType="body" fontSize="12" color="rgb(111,163,155)" textAlign="center" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0" bold="true"><p>确认安全</p></content></shape><shape type="text" topLeftX="232" topLeftY="402" width="146" height="16"><content textType="body" fontSize="9" color="rgb(91,103,112)" textAlign="center" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0"><p>高置信否定进抑制池</p></content></shape><shape type="round-rect" topLeftX="394" topLeftY="374" width="146" height="46" presetHandlers="8"><fill><fillColor color="rgb(250,240,224)"/></fill></shape><shape type="text" topLeftX="394" topLeftY="382" width="146" height="18"><content textType="body" fontSize="12" color="rgb(217,150,46)" textAlign="center" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0" bold="true"><p>存疑</p></content></shape><shape type="text" topLeftX="394" topLeftY="402" width="146" height="16"><content textType="body" fontSize="9" color="rgb(91,103,112)" textAlign="center" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0"><p>转人工复核</p></content></shape><shape type="round-rect" topLeftX="574" topLeftY="118" width="332" height="302" presetHandlers="8"><fill><fillColor color="rgb(232,240,246)"/></fill></shape><shape type="round-rect" topLeftX="574" topLeftY="118" width="4" height="302" presetHandlers="2"><fill><fillColor color="rgb(52,94,128)"/></fill></shape><shape type="text" topLeftX="594" topLeftY="134" width="300" height="18"><content textType="body" fontSize="13.5" color="rgb(52,94,128)" textAlign="left" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0" bold="true"><p>无候选分支 · 不直接放行</p></content></shape><shape type="rect" topLeftX="594" topLeftY="172" width="6" height="6"><fill><fillColor color="rgb(52,94,128)"/></fill></shape><shape type="text" topLeftX="610" topLeftY="168" width="280" height="18"><content textType="body" fontSize="12" color="rgb(43,47,54)" textAlign="left" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0" bold="true"><p>10% 抽样</p></content></shape><shape type="text" topLeftX="610" topLeftY="188" width="284" height="40"><content textType="body" fontSize="10.5" color="rgb(91,103,112)" textAlign="left" fontFamily="思源黑体" lineSpacing="multiple:1.45" verticalAlign="top" letterSpacing="0"><p>工具无候选的文件默认抽样 10% 送 LLM 复核，捕捉工具盲区</p></content></shape><shape type="rect" topLeftX="594" topLeftY="250" width="6" height="6"><fill><fillColor color="rgb(52,94,128)"/></fill></shape><shape type="text" topLeftX="610" topLeftY="246" width="280" height="18"><content textType="body" fontSize="12" color="rgb(43,47,54)" textAlign="left" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0" bold="true"><p>全量兜底</p></content></shape><shape type="text" topLeftX="610" topLeftY="266" width="284" height="40"><content textType="body" fontSize="10.5" color="rgb(91,103,112)" textAlign="left" fontFamily="思源黑体" lineSpacing="multiple:1.45" verticalAlign="top" letterSpacing="0"><p>生产与评估默认 full_recheck 全量复核，安全优先于成本</p></content></shape><shape type="rect" topLeftX="594" topLeftY="328" width="6" height="6"><fill><fillColor color="rgb(52,94,128)"/></fill></shape><shape type="text" topLeftX="610" topLeftY="324" width="280" height="18"><content textType="body" fontSize="12" color="rgb(43,47,54)" textAlign="left" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="0" bold="true"><p>命中扩审</p></content></shape><shape type="text" topLeftX="610" topLeftY="344" width="284" height="40"><content textType="body" fontSize="10.5" color="rgb(91,103,112)" textAlign="left" fontFamily="思源黑体" lineSpacing="multiple:1.45" verticalAlign="top" letterSpacing="0"><p>抽样一旦命中，立即扩大该批次审计范围</p></content></shape><shape type="round-rect" topLeftX="54" topLeftY="432" width="852" height="64" presetHandlers="8"><fill><fillColor color="rgb(31,46,56)"/></fill></shape><shape type="text" topLeftX="78" topLeftY="442" width="400" height="14"><content textType="body" fontSize="9.5" color="rgb(217,150,46)" textAlign="left" fontFamily="Roboto Mono" lineSpacing="multiple:1.35" verticalAlign="top" letterSpacing="1" bold="true"><p>WHY IT WORKS · 封闭裁决 vs 开放生成</p></content></shape><shape type="text" topLeftX="78" topLeftY="462" width="820" height="30"><content textType="body" fontSize="14" color="rgb(43,47,54)" textAlign="left" fontFamily="思源黑体" lineSpacing="multiple:1.35" verticalAlign="top">['<p><span color="rgb(220,140,138)" bold="true" fontSize="12">开放生成：</span><span color="rgb(200,210,218)" fontSize="12">幻觉不可复现、整文件投喂成本高    →    </span><span color="rgb(217,150,46)" bold="true" fontSize="12">封闭裁决：</span><span color="rgb(255,255,255)" bold="true" fontSize="12">证据约束、投票可复现、调用量约降 70%</span></p>']</content></shape></data><note><content textType="body" fontSize="12"><p>Stage 2 的关键是封闭：输入只有 Stage 1 的候选，先 RAG 注入 CWE 判据，再用 CodeSlicer 切最小上下文，然后三次独立采样多数投票，输出只有确认漏洞、确认安全、存疑三选一。右边是兜底设计：工具没候选的文件绝不直接放行，默认抽样 10%，生产和评估环境用全量复核。开放生成有幻觉、不可复现、成本高，封闭裁决三个问题一起解决。</p></content></note></slide>